# Resend (https://resend.com) — API key for sending the /about contact form email.
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
RESEND_API_KEY=
CONTACT_EMAIL_TO=

# Supabase (https://supabase.com) — Auth + scores integration (project jmnrxworahnuzuvjedty).
# NEXT_PUBLIC_* values are safe for the client bundle; fill them in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres access (not used by app code / SDK) — for admin/migration tooling only.
SUPABASE_KEY_PASSWORD=
